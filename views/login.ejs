        <header class="ic-d-flex ic-flex-col ic-gap-2 ic-text-center">
          <h1 class="ic-playf ic-display ic-bold ic-text-neutral-900 ic-leading-tight ic-margin-0">Welcome back</h1>
          <p class="ic-merri ic-smmed ic-text-neutral-500 ic-leading-normal">Sign in to your account to continue.</p>
        </header>

        <form action="/auth/login" method="post" class="ic-d-flex ic-flex-col ic-gap-5">

          <div class="ic-d-flex ic-flex-col ic-gap-2">
            <label for="email" class="ic-poppi ic-smmed ic-semi ic-text-neutral-700">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="ic-poppi ic-medium ic-w-full ic-padding-x-4 ic-padding-y-3 ic-bg-white ic-border-1 ic-border-neutral-300 ic-rounded-none ic-text-neutral-900 ic-appearance-none ic-focus-ring-neutral-400">
          </div>

          <div class="ic-d-flex ic-flex-col ic-gap-2">
            <label for="password" class="ic-poppi ic-smmed ic-semi ic-text-neutral-700">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" class="ic-poppi ic-medium ic-w-full ic-padding-x-4 ic-padding-y-3 ic-bg-white ic-border-1 ic-border-neutral-300 ic-rounded-none ic-text-neutral-900 ic-appearance-none ic-focus-ring-neutral-400">
          </div>

          <button type="submit" class="ic-btn-dark ic-btn-lg ic-w-full ic-rounded-none ic-poppi ic-semi ic-tracking-wide ic-margin-top-1">
            Sign in
          </button>

        </form>

        <footer class="ic-text-center">
          <p class="ic-poppi ic-smmed ic-text-neutral-500">
            Don't have an account?
            <a href="/signup" class="ic-text-neutral-900 ic-semi ic-underline">Sign up</a>
          </p>
        </footer>

      </div>
    </section>

  </main>

